<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.example.tiny_upgrader">
    <!-- 必需：Android 8.0 及以上安装未知来源应用所需的权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".TinyUpgraderDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <!-- ... 你的其他 application 配置 ... -->

        <!-- 必需：声明 FileProvider -->
        <!-- 使用插件专属 authority，避免与宿主的 FileProvider 冲突 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.tiny_upgrader.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>
</manifest>
